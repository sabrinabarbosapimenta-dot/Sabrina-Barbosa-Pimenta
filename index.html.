<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sabrina Barbosa Pimenta — Gestão Comercial &amp; Expansão</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-deep:#081525;
    --navy:#0e2338;
    --navy-mid:#153956;
    --navy-line:#2a4a68;
    --paper:#f3f5f7;
    --paper-2:#e7ebee;
    --ink:#0e2338;
    --ink-soft:#4c6178;
    --silver:#aebdcc;
    --silver-dim:#7e93a8;
    --teal:#22c7b8;
    --teal-dim:#1a9d92;
    --white:#ffffff;
    --serif-line: 1px solid rgba(174,189,204,0.25);
    --maxw: 1180px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Manrope',sans-serif;
    background:var(--paper);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,h4{
    font-family:'Space Grotesk',sans-serif;
    margin:0;
    font-weight:600;
    letter-spacing:-0.01em;
  }
  p{margin:0;}
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 32px;}
  img{display:block; max-width:100%; height:auto;}
  a{color:inherit;}
  ::selection{background:var(--teal); color:var(--navy-deep);}

  /* progress bar */
  #progress{
    position:fixed; top:0; left:0; height:3px; width:0%;
    background:var(--teal); z-index:999; transition:width .1s linear;
  }

  /* side dot nav */
  #dotnav{
    position:fixed; right:22px; top:50%; transform:translateY(-50%);
    z-index:900; display:flex; flex-direction:column; gap:14px;
  }
  #dotnav button{
    width:9px; height:9px; border-radius:50%; border:1.5px solid var(--silver-dim);
    background:transparent; cursor:pointer; padding:0; transition:all .25s ease;
  }
  #dotnav button.active{ background:var(--teal); border-color:var(--teal); transform:scale(1.3); }
  @media (max-width:900px){ #dotnav{display:none;} }

  section{ position:relative; }

  /* ============ HERO ============ */
  #hero{
    min-height:100svh; display:flex; align-items:flex-end;
    background:linear-gradient(180deg, rgba(8,21,37,0.5) 0%, rgba(8,21,37,0.74) 55%, var(--navy-deep) 100%), url('data:image/jpeg;base64,') center 25%/cover no-repeat;
    color:var(--white);
    padding-bottom:64px;
  }
  .hero-inner{ width:100%; }
  .hero-kicker{
    display:flex; align-items:center; gap:10px;
    color:var(--silver); font-family:'IBM Plex Mono',monospace; font-size:13px;
    margin-bottom:22px; letter-spacing:0.02em;
  }
  .hero-kicker .dot{ width:6px; height:6px; border-radius:50%; background:var(--teal); }
  #hero h1{
    font-size:clamp(34px, 6vw, 64px);
    line-height:1.05;
    max-width:920px;
    color:var(--white);
  }
  #hero h1 em{ font-style:normal; color:var(--teal); }
  .hero-sub{
    margin-top:22px; font-size:19px; color:var(--silver); max-width:560px; font-weight:500;
  }
  .hero-stats{
    margin-top:46px; display:flex; gap:0; flex-wrap:wrap;
    border-top:var(--serif-line);
  }
  .hero-stat{
    padding:16px 28px 0 0; margin-right:28px; min-width:140px;
  }
  .hero-stat b{
    display:block; font-family:'IBM Plex Mono',monospace; font-size:26px; color:var(--teal); font-weight:600;
  }
  .hero-stat span{ font-size:13px; color:var(--silver-dim); }
  .scroll-cue{
    position:absolute; bottom:26px; left:32px; color:var(--silver-dim);
    font-size:12px; font-family:'IBM Plex Mono',monospace; display:flex; align-items:center; gap:8px;
  }
  .scroll-cue .line{ width:28px; height:1px; background:var(--silver-dim); animation:pulse-line 2s infinite; }
  @keyframes pulse-line{ 0%,100%{opacity:.3;} 50%{opacity:1;} }

  /* ============ SECTION HEADERS ============ */
  .sec-head{
    display:flex; align-items:baseline; gap:18px; margin-bottom:44px;
  }
  .sec-num{
    font-family:'IBM Plex Mono',monospace; font-size:14px; color:var(--teal-dim); font-weight:600;
  }
  .sec-head h2{ font-size:clamp(26px,3.4vw,38px); }
  .light-on-dark .sec-num{ color:var(--teal); }

  /* ============ QUEM SOU ============ */
  #sobre{ background:var(--paper); padding:118px 0 100px; }
  .sobre-grid{
    display:grid; grid-template-columns: 0.85fr 1.15fr; gap:64px; align-items:center;
  }
  .sobre-photo{
    position:relative;
  }
  .sobre-photo img{
    border-radius:2px; width:100%; object-fit:cover; aspect-ratio:4/5;
  }
  .sobre-photo::before{
    content:""; position:absolute; top:18px; left:-18px; width:100%; height:100%;
    border:1.5px solid var(--teal-dim); z-index:-1; border-radius:2px;
  }
  .sobre-text p{ font-size:18px; line-height:1.65; color:var(--ink-soft); margin-bottom:20px; }
  .sobre-text p b{ color:var(--ink); font-weight:700; }
  .sobre-quote{
    font-family:'Space Grotesk',sans-serif; font-size:22px; line-height:1.4; color:var(--navy);
    border-left:3px solid var(--teal); padding-left:22px; margin:30px 0;
  }
  @media (max-width:820px){ .sobre-grid{grid-template-columns:1fr; gap:40px;} .sobre-photo{max-width:340px; margin:0 auto;} .sobre-photo::before{display:none;} }

  /* ============ TRAJETORIA (accordion) ============ */
  #trajetoria{ background:var(--navy-deep); color:var(--white); padding:118px 0 100px; }
  #trajetoria .sec-head h2{ color:var(--white); }
  .traj-hint{ color:var(--silver-dim); font-size:14px; margin:-24px 0 40px; font-family:'IBM Plex Mono',monospace; }
  .accordion{ border-top:var(--serif-line); }
  .acc-item{ border-bottom:var(--serif-line); }
  .acc-trigger{
    width:100%; background:none; border:none; color:var(--white); cursor:pointer;
    display:flex; justify-content:space-between; align-items:center; gap:20px;
    padding:26px 0; text-align:left; font-family:'Space Grotesk',sans-serif;
  }
  .acc-trigger:hover .acc-role{ color:var(--teal); }
  .acc-left{ display:flex; align-items:baseline; gap:18px; }
  .acc-year{ font-family:'IBM Plex Mono',monospace; font-size:13px; color:var(--silver-dim); min-width:46px; }
  .acc-company{ font-size:22px; font-weight:600; }
  .acc-role{ font-size:14px; color:var(--silver); font-weight:400; font-family:'Manrope',sans-serif; transition:color .2s; }
  .acc-plus{
    width:26px; height:26px; border:1px solid var(--silver-dim); border-radius:50%; position:relative; flex:none;
    transition:transform .3s ease, border-color .3s ease;
  }
  .acc-plus::before, .acc-plus::after{
    content:""; position:absolute; background:var(--silver); top:50%; left:50%; transform:translate(-50%,-50%);
  }
  .acc-plus::before{ width:10px; height:1.4px; }
  .acc-plus::after{ width:1.4px; height:10px; transition:opacity .25s ease; }
  .acc-item.open .acc-plus{ transform:rotate(180deg); border-color:var(--teal); }
  .acc-item.open .acc-plus::after{ opacity:0; }
  .acc-panel{
    max-height:0; overflow:hidden; transition:max-height .45s ease;
  }
  .acc-panel-inner{ padding:0 0 34px; display:grid; grid-template-columns:1.4fr 1fr; gap:40px; }
  .acc-panel-inner.no-media{ grid-template-columns:1fr; max-width:760px; }
  .acc-flow{ display:flex; flex-direction:column; gap:16px; margin-bottom:22px; }
  .acc-flow-step{ display:flex; gap:14px; }
  .acc-flow-step .k{ font-family:'IBM Plex Mono',monospace; color:var(--teal); font-size:12px; padding-top:3px; }
  .acc-flow-step p{ color:var(--silver); line-height:1.55; font-size:15.5px; }
  .acc-result{
    margin-top:18px; padding:16px 20px; border:1px solid var(--navy-line); border-radius:2px;
    display:flex; align-items:center; gap:16px; background:rgba(34,199,184,0.05);
  }
  .acc-result b{ font-family:'IBM Plex Mono',monospace; color:var(--teal); font-size:20px; white-space:nowrap; }
  .acc-result span{ color:var(--silver); font-size:14px; }
  .acc-media img{ border-radius:2px; width:100%; object-fit:cover; height:100%; max-height:280px; }
  @media (max-width:760px){
    .acc-panel-inner{ grid-template-columns:1fr; }
    .acc-company{ font-size:18px; }
    .acc-role{ display:none; }
  }

  /* ============ METODO (stepper) ============ */
  #metodo{ background:var(--paper); padding:118px 0 110px; }
  .metodo-grid{ display:grid; grid-template-columns: 1fr 1.3fr; gap:60px; }
  .metodo-list{ display:flex; flex-direction:column; }
  .metodo-step-btn{
    display:flex; align-items:center; gap:18px; padding:16px 0; background:none; border:none; cursor:pointer;
    border-top:1px solid var(--paper-2); text-align:left; width:100%;
  }
  .metodo-step-btn:last-child{ border-bottom:1px solid var(--paper-2); }
  .metodo-step-btn .n{ font-family:'IBM Plex Mono',monospace; font-size:14px; color:var(--silver-dim); }
  .metodo-step-btn .t{ font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:600; color:var(--ink-soft); transition:color .2s; }
  .metodo-step-btn.active .n{ color:var(--teal-dim); }
  .metodo-step-btn.active .t{ color:var(--navy); }
  .metodo-step-btn.active{ background:linear-gradient(90deg, rgba(34,199,184,0.06), transparent); }
  .metodo-display{
    background:var(--navy-deep); color:var(--white); border-radius:2px; padding:44px; min-height:280px;
    display:flex; flex-direction:column; justify-content:center;
  }
  .metodo-display .n-big{ font-family:'IBM Plex Mono',monospace; color:var(--teal); font-size:15px; margin-bottom:14px; }
  .metodo-display h3{ font-size:26px; margin-bottom:16px; color:var(--white); }
  .metodo-display p{ color:var(--silver); line-height:1.65; font-size:16.5px; }
  @media (max-width:820px){ .metodo-grid{ grid-template-columns:1fr; } .metodo-display{ padding:32px 26px; } }

  /* ============ COMO LIDERO (manifesto) ============ */
  #lidero{ background:var(--navy-mid); color:var(--white); padding:110px 0; }
  .lidero-inner{ max-width:820px; }
  .lidero-eyebrow{ font-family:'IBM Plex Mono',monospace; color:var(--teal); font-size:13px; margin-bottom:20px; }
  .lidero-inner h2{ font-size:clamp(26px,3.6vw,38px); color:var(--white); line-height:1.3; margin-bottom:44px; }
  .lidero-list{ display:flex; flex-direction:column; }
  .lidero-list li{
    list-style:none; padding:20px 0; border-top:1px solid rgba(255,255,255,0.12);
    font-family:'Space Grotesk',sans-serif; font-size:22px; display:flex; gap:18px; align-items:center;
  }
  .lidero-list li:last-child{ border-bottom:1px solid rgba(255,255,255,0.12); }
  .lidero-list li .num{ font-family:'IBM Plex Mono',monospace; font-size:13px; color:var(--silver-dim); font-weight:400; }
  .lidero-closing{ margin-top:36px; color:var(--silver); font-size:16px; line-height:1.7; max-width:680px; }

  /* ============ DIFERENCIAL (pills) ============ */
  #diferencial{ background:var(--paper); padding:110px 0; }
  .dif-grid{ display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; }
  .dif-text p{ font-size:18px; line-height:1.7; color:var(--ink-soft); margin-bottom:18px; }
  .pill-field{ display:flex; flex-wrap:wrap; gap:10px; }
  .pill{
    padding:10px 18px; border:1px solid var(--paper-2); border-radius:20px; font-size:14.5px;
    color:var(--ink-soft); cursor:default; transition:all .25s ease; background:var(--white);
  }
  .pill:hover{ border-color:var(--teal); color:var(--navy); background:rgba(34,199,184,0.08); transform:translateY(-2px); }
  @media (max-width:820px){ .dif-grid{ grid-template-columns:1fr; gap:30px; } }
  .entrego-grid{
    margin-top:70px; padding-top:50px; border-top:1px solid var(--paper-2);
    display:grid; grid-template-columns:repeat(6,1fr); gap:22px;
  }
  .entrego-item .t{ font-family:'Space Grotesk',sans-serif; font-size:17px; color:var(--navy); margin-bottom:8px; }
  .entrego-item .d{ font-size:13.5px; color:var(--ink-soft); line-height:1.5; }
  .entrego-item .k{ font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--teal-dim); display:block; margin-bottom:10px; }
  @media (max-width:980px){ .entrego-grid{ grid-template-columns:repeat(3,1fr); } }
  @media (max-width:600px){ .entrego-grid{ grid-template-columns:repeat(2,1fr); } }

  /* ============ DADOS/TECNOLOGIA ============ */
  #dados{ background:var(--navy-deep); color:var(--white); padding:110px 0; }
  #dados .sec-head h2{ color:var(--white); }
  .dados-top{ display:grid; grid-template-columns:1.4fr 0.9fr; gap:40px; align-items:end; margin-bottom:40px; }
  .dados-photo img{ border-radius:2px; aspect-ratio:16/10; object-fit:cover; object-position:top; }
  @media (max-width:760px){ .dados-top{ grid-template-columns:1fr; } .dados-photo{ max-width:320px; } }
  .tools-row{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom:56px; }
  .tool-tag{
    font-family:'IBM Plex Mono',monospace; font-size:13px; padding:9px 14px; border:1px solid var(--navy-line);
    color:var(--silver); border-radius:2px;
  }
  .glossary-label{ font-size:14px; color:var(--silver-dim); margin-bottom:18px; font-family:'IBM Plex Mono',monospace; }
  .glossary-grid{ display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:14px; }
  .flip-card{ perspective:1000px; height:130px; cursor:pointer; }
  .flip-inner{
    position:relative; width:100%; height:100%; transition:transform .55s cubic-bezier(.4,.2,.2,1); transform-style:preserve-3d;
  }
  .flip-card.flipped .flip-inner{ transform:rotateY(180deg); }
  .flip-face{
    position:absolute; inset:0; backface-visibility:hidden; border-radius:2px;
    display:flex; align-items:center; justify-content:center; flex-direction:column; padding:14px; text-align:center;
    border:1px solid var(--navy-line);
  }
  .flip-front{ background:var(--navy); }
  .flip-front b{ font-family:'IBM Plex Mono',monospace; font-size:19px; color:var(--teal); }
  .flip-front span{ font-size:11.5px; color:var(--silver-dim); margin-top:6px; }
  .flip-back{ background:var(--teal); color:var(--navy-deep); transform:rotateY(180deg); font-size:12.5px; line-height:1.4; font-weight:600; }

  /* ============ RESULTADOS (counters) ============ */
  #resultados{ background:var(--paper); padding:118px 0; }
  .res-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--paper-2); border:1px solid var(--paper-2); }
  .res-card{ background:var(--paper); padding:44px 30px; text-align:left; }
  .res-num{ font-family:'IBM Plex Mono',monospace; font-size:clamp(34px,4vw,48px); color:var(--navy); font-weight:600; }
  .res-num .accent{ color:var(--teal-dim); }
  .res-label{ margin-top:10px; font-size:14.5px; color:var(--ink-soft); line-height:1.4; }
  .res-source{ margin-top:14px; font-size:12px; color:var(--silver-dim); font-family:'IBM Plex Mono',monospace; }
  @media (max-width:820px){ .res-grid{ grid-template-columns:1fr 1fr; } }
  @media (max-width:520px){ .res-grid{ grid-template-columns:1fr; } }

  /* ============ DEPOIMENTOS ============ */
  #depoimentos{ background:var(--navy-mid); color:var(--white); padding:118px 0; overflow:hidden; }
  #depoimentos .sec-head h2{ color:var(--white); }
  .testi-wrap{ position:relative; max-width:760px; margin:0 auto; min-height:260px; }
  .testi-slide{
    position:absolute; inset:0; opacity:0; transition:opacity .5s ease; pointer-events:none;
  }
  .testi-slide.active{ opacity:1; pointer-events:auto; }
  .testi-quote{ font-family:'Space Grotesk',sans-serif; font-size:22px; line-height:1.5; color:var(--white); }
  .testi-who{ margin-top:26px; display:flex; flex-direction:column; gap:2px; }
  .testi-who b{ color:var(--teal); font-size:15px; }
  .testi-who span{ color:var(--silver-dim); font-size:13px; }
  .testi-nav{ display:flex; justify-content:center; gap:10px; margin-top:40px; }
  .testi-dot{ width:8px; height:8px; border-radius:50%; border:1px solid var(--silver-dim); background:none; cursor:pointer; }
  .testi-dot.active{ background:var(--teal); border-color:var(--teal); }

  /* ============ FORMACAO ============ */
  #formacao{ background:var(--paper); padding:110px 0; }
  .form-grid{ display:grid; grid-template-columns:1fr 1fr; gap:50px; }
  .form-item{ padding:22px 0; border-top:1px solid var(--paper-2); }
  .form-item:last-child{ border-bottom:1px solid var(--paper-2); }
  .form-item h4{ font-size:17px; margin-bottom:4px; }
  .form-item span{ font-size:13.5px; color:var(--ink-soft); font-family:'IBM Plex Mono',monospace; }
  .courses-tags{ display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
  .courses-tags span.ctag{ font-family:'Manrope'; font-size:12.5px; padding:5px 10px; background:var(--paper-2); border-radius:12px; color:var(--ink-soft); }
  @media (max-width:820px){ .form-grid{ grid-template-columns:1fr; gap:10px; } }

  /* ============ CONTATO ============ */
  #contato{ background:var(--navy-deep); color:var(--white); padding:130px 0 90px; }
  .contato-grid{ display:grid; grid-template-columns:1.3fr 0.9fr; gap:60px; align-items:center; }
  #contato h2{ font-size:clamp(28px,4vw,42px); color:var(--white); line-height:1.25; margin-bottom:24px; }
  #contato p{ color:var(--silver); font-size:17px; line-height:1.6; max-width:520px; margin-bottom:36px; }
  .contato-links{ display:flex; gap:16px; flex-wrap:wrap; }
  .btn{
    display:inline-flex; align-items:center; gap:10px; padding:15px 26px; border-radius:2px; font-weight:600;
    font-size:15px; text-decoration:none; transition:all .25s ease;
  }
  .btn-primary{ background:var(--teal); color:var(--navy-deep); }
  .btn-primary:hover{ background:var(--white); }
  .btn-ghost{ border:1px solid var(--navy-line); color:var(--white); }
  .btn-ghost:hover{ border-color:var(--teal); color:var(--teal); }
  .contato-photo img{ border-radius:2px; aspect-ratio:4/5; object-fit:cover; }
  @media (max-width:820px){ .contato-grid{ grid-template-columns:1fr; } .contato-photo{ max-width:280px; } }

  footer{ background:var(--navy-deep); color:var(--silver-dim); padding:26px 0 40px; font-size:13px; border-top:1px solid var(--navy-line); }
  footer .wrap{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; }

  .reveal{ opacity:0; transform:translateY(18px); transition:opacity .7s ease, transform .7s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }
</style>
</head>
<body>

<div id="progress"></div>
<nav id="dotnav">
  <button data-target="#hero" class="active" aria-label="Início"></button>
  <button data-target="#sobre" aria-label="Quem sou"></button>
  <button data-target="#trajetoria" aria-label="Trajetória"></button>
  <button data-target="#metodo" aria-label="Método"></button>
  <button data-target="#lidero" aria-label="Liderança"></button>
  <button data-target="#diferencial" aria-label="Diferencial"></button>
  <button data-target="#dados" aria-label="Dados"></button>
  <button data-target="#resultados" aria-label="Resultados"></button>
  <button data-target="#depoimentos" aria-label="Depoimentos"></button>
  <button data-target="#contato" aria-label="Contato"></button>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="wrap hero-inner">
    <div class="hero-kicker"><span class="dot"></span> Sabrina Barbosa Pimenta — Coordenação de Expansão &amp; Gestão Comercial</div>
    <h1>Estruturo operações. Desenvolvo pessoas. Transformo gargalos em <em>resultado.</em></h1>
    <p class="hero-sub">Não entro em uma operação apenas para fazer gestão. Entro para entender, estruturar, alavancar e fazer o resultado acontecer.</p>
    <div class="hero-stats">
      <div class="hero-stat"><b>R$60mil → R$160mil</b><span>evolução mensal de uma operação que estruturei do zero</span></div>
      <div class="hero-stat"><b>+50%</b><span>faturamento em 4 meses de gestão</span></div>
      <div class="hero-stat"><b>12</b><span>pessoas lideradas na operação mais recente</span></div>
    </div>
  </div>
  <div class="scroll-cue"><span class="line"></span> role para conhecer minha trajetória</div>
</section>

<!-- QUEM SOU -->
<section id="sobre">
  <div class="wrap">
    <div class="sobre-grid">
      <div class="sobre-photo reveal"><img src="data:image/jpeg;base64," alt="Sabrina Barbosa Pimenta"></div>
      <div class="sobre-text reveal">
        <div class="sec-head"><span class="sec-num">01</span><h2>Quem sou</h2></div>
